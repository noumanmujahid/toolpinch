{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/calculators",
      "destination": "/work-time-tools",
      "permanent": true
    },
    {
      "source": "/guides/what-is-faq-schema",
      "destination": "/tools/structured-data-builder",
      "permanent": true
    },
    {
      "source": "/guides/how-to-write-meta-descriptions",
      "destination": "/tools/meta-description-generator",
      "permanent": true
    },
    {
      "source": "/guides/how-to-create-a-robots-txt-file",
      "destination": "/tools/robots-txt-tester",
      "permanent": true
    },
    {
      "source": "/tools/ai-meta-description-generator",
      "destination": "/tools/meta-description-generator",
      "permanent": true
    },
    {
      "source": "/tools/keyword-density-checker",
      "destination": "/seo-tools",
      "permanent": true
    },
    {
      "source": "/categories/webmaster",
      "destination": "/seo-tools",
      "permanent": true
    },
    {
      "source": "/tools/loan-calculator",
      "destination": "/tools/loan-amortization-calculator",
      "permanent": true
    },
    {
      "source": "/tools/emi-calculator",
      "destination": "/tools/loan-amortization-calculator",
      "permanent": true
    },
    {
      "source": "/tools/age-calculator",
      "destination": "/tools/date-difference-calculator",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
